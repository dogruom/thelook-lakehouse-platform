{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "effortLevel": "medium",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "NotebookEdit",
      "WebSearch",
      "Skill",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:spark.apache.org)",
      "WebFetch(domain:docs.delta.io)",
      "WebFetch(domain:delta.io)",
      "WebFetch(domain:kafka.apache.org)",
      "WebFetch(domain:docs.confluent.io)",
      "WebFetch(domain:docs.getdbt.com)",
      "WebFetch(domain:airflow.apache.org)",
      "WebFetch(domain:docs.aws.amazon.com)",
      "WebFetch(domain:docs.databricks.com)",
      "WebFetch(domain:docs.pydantic.dev)",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:duckdb.org)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:docs.docker.com)",
      "WebFetch(domain:developer.hashicorp.com)",
      "Bash(python *)",
      "Bash(py *)",
      "Bash(.venv/Scripts/python.exe *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(mypy *)",
      "Bash(dbt *)",
      "Bash(pre-commit *)",
      "Bash(lint-imports*)",
      "Bash(git *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh repo view*)",
      "Bash(docker compose *)",
      "Bash(docker ps*)",
      "Bash(docker logs *)",
      "Bash(docker exec *)",
      "Bash(docker stats*)",
      "Bash(docker images*)",
      "Bash(docker inspect --format*)",
      "Bash(ls *)",
      "Bash(wc *)",
      "PowerShell(python *)",
      "PowerShell(py *)",
      "PowerShell(.\\.venv\\Scripts\\python.exe *)",
      "PowerShell(.venv\\Scripts\\python.exe *)",
      "PowerShell(.\\.venv\\Scripts\\Activate.ps1*)",
      "PowerShell(pytest *)",
      "PowerShell(ruff *)",
      "PowerShell(mypy *)",
      "PowerShell(dbt *)",
      "PowerShell(pre-commit *)",
      "PowerShell(lint-imports*)",
      "PowerShell(git *)",
      "PowerShell(gh pr *)",
      "PowerShell(gh run *)",
      "PowerShell(gh repo view*)",
      "PowerShell(docker compose *)",
      "PowerShell(docker ps*)",
      "PowerShell(docker logs *)",
      "PowerShell(docker exec *)",
      "PowerShell(docker stats*)",
      "PowerShell(docker images*)",
      "PowerShell(docker inspect --format*)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Test-Path *)",
      "PowerShell(Get-Date*)",
      "PowerShell(Measure-Object*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.prod)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/*.tfvars)",
      "Read(**/s3.local.json)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.docker/config.json)",
      "Edit(**/.env)",
      "Edit(**/.env.*.local)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(git checkout -- *)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(rm -r *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(gh auth token*)",
      "Bash(gh repo delete*)",
      "Bash(gh secret *)",
      "Bash(docker system prune*)",
      "Bash(docker volume prune*)",
      "Bash(docker image prune*)",
      "Bash(docker volume rm*)",
      "Bash(docker compose down -v*)",
      "Bash(docker compose down * -v*)",
      "Bash(docker compose down --volumes*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git filter-branch*)",
      "PowerShell(git filter-repo*)",
      "PowerShell(git checkout -- *)",
      "PowerShell(Remove-Item * -Recurse*)",
      "PowerShell(rm * -Recurse*)",
      "PowerShell(del /s*)",
      "PowerShell(rd /s*)",
      "PowerShell(rmdir /s*)",
      "PowerShell(curl *)",
      "PowerShell(wget *)",
      "PowerShell(Invoke-WebRequest*)",
      "PowerShell(iwr *)",
      "PowerShell(Invoke-RestMethod*)",
      "PowerShell(irm *)",
      "PowerShell(Start-BitsTransfer*)",
      "PowerShell(gh auth token*)",
      "PowerShell(gh repo delete*)",
      "PowerShell(gh secret *)",
      "PowerShell(docker system prune*)",
      "PowerShell(docker volume prune*)",
      "PowerShell(docker image prune*)",
      "PowerShell(docker volume rm*)",
      "PowerShell(docker compose down -v*)",
      "PowerShell(docker compose down * -v*)",
      "PowerShell(docker compose down --volumes*)"
    ],
    "ask": [
      "Bash(git rebase*)",
      "Bash(git branch -D*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git tag -d*)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(aws *)",
      "PowerShell(git rebase*)",
      "PowerShell(git branch -D*)",
      "PowerShell(git stash drop*)",
      "PowerShell(git stash clear*)",
      "PowerShell(git tag -d*)",
      "PowerShell(terraform apply*)",
      "PowerShell(terraform destroy*)",
      "PowerShell(aws *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|NotebookEdit|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_commands.py"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}

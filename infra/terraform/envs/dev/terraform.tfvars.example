# Copy to terraform.tfvars (git-ignored) and adjust.
region              = "eu-central-1"
owner_principal_arn = "arn:aws:iam::123456789012:user/owner"

github_repo                 = "dogruom/thelook-lakehouse-platform"
github_environment          = "aws-dev"
create_github_oidc_provider = true # false if the account already has the GitHub OIDC provider
force_destroy_data          = true

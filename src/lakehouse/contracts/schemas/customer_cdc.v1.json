{
  "$defs": {
    "CdcAction": {
      "enum": [
        "I",
        "U",
        "D"
      ],
      "title": "CdcAction",
      "type": "string"
    },
    "LoyaltyTier": {
      "enum": [
        "Bronze",
        "Silver",
        "Gold",
        "Platinum"
      ],
      "title": "LoyaltyTier",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "``customer_cdc`` v1. Wire names of CDC metadata carry a leading underscore.",
  "properties": {
    "_cdc_action": {
      "$ref": "#/$defs/CdcAction"
    },
    "_cdc_sequence": {
      "minimum": 1,
      "title": " Cdc Sequence",
      "type": "integer"
    },
    "_cdc_ts": {
      "format": "date-time",
      "title": " Cdc Ts",
      "type": "string"
    },
    "brand_id": {
      "pattern": "^brand_[a-z0-9_]{1,40}$",
      "title": "Brand Id",
      "type": "string"
    },
    "city": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "City"
    },
    "country": {
      "pattern": "^[A-Z]{2}$",
      "title": "Country",
      "type": "string"
    },
    "customer_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Customer Id",
      "type": "string"
    },
    "email": {
      "maxLength": 254,
      "pattern": "^[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]+@[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$",
      "title": "Email",
      "type": "string"
    },
    "event_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Event Id",
      "type": "string"
    },
    "first_name": {
      "maxLength": 50,
      "minLength": 1,
      "title": "First Name",
      "type": "string"
    },
    "last_name": {
      "maxLength": 50,
      "minLength": 1,
      "title": "Last Name",
      "type": "string"
    },
    "loyalty_tier": {
      "$ref": "#/$defs/LoyaltyTier"
    },
    "phone": {
      "anyOf": [
        {
          "pattern": "^\\+[1-9][0-9]{1,14}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Phone"
    },
    "produced_at": {
      "format": "date-time",
      "title": "Produced At",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "enum": [
        1
      ],
      "title": "Schema Version",
      "type": "integer"
    },
    "signup_date": {
      "format": "date",
      "title": "Signup Date",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "brand_id",
    "schema_version",
    "produced_at",
    "customer_id",
    "first_name",
    "last_name",
    "email",
    "country",
    "loyalty_tier",
    "signup_date",
    "_cdc_action",
    "_cdc_sequence",
    "_cdc_ts"
  ],
  "title": "CustomerCdcEvent",
  "type": "object"
}

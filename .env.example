# =============================================================================
# Multi-Tenant CRM Lakehouse — Environment Configuration (TEMPLATE)
# =============================================================================
# This file contains PLACEHOLDERS ONLY. Never put real values here.
#
#   python scripts/bootstrap_env.py   # creates .env with random local secrets if .env does
#                                     # not exist; never overwrites it, never prints values
#   python scripts/check_env.py       # lists keys missing/empty in .env (names only)
#
# Manual alternative: copy to .env and replace every value marked `change-me`.
# .env is gitignored. AWS credentials never go into this file: use an
# IAM Identity Center (SSO) profile locally and GitHub OIDC in CI (ADR-0008).
# =============================================================================

# -----------------------------------------------------------------------------
# PROJECT
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=crm_lakehouse
ENVIRONMENT=local
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# POSTGRESQL (Airflow metadata + Hive metastore)
# -----------------------------------------------------------------------------
POSTGRES_USER=crm_admin
POSTGRES_PASSWORD=change-me
POSTGRES_ROOT_DB=postgres
# Host-side port (container listens on 5432); 15432 avoids a native PostgreSQL on 5432.
POSTGRES_HOST_PORT=15432

AIRFLOW_DB_NAME=airflow_metadata
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me

HIVE_METASTORE_DB_NAME=hive_metastore
HIVE_METASTORE_DB_USER=hive
HIVE_METASTORE_DB_PASSWORD=change-me

# -----------------------------------------------------------------------------
# OBJECT STORAGE (SeaweedFS locally; AWS S3 in the aws environment)
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://seaweedfs:9000
S3_PATH_STYLE_ACCESS=true
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
LAKEHOUSE_BUCKET=lakehouse

# -----------------------------------------------------------------------------
# KAFKA (KRaft)
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
# Spark jobs run inside the compose network and use the internal listener (default: kafka:9092).
# LAKEHOUSE_KAFKA_BOOTSTRAP=kafka:9092
# KRaft cluster ID: a 22-character base64 UUID, NOT a secret, so it has a fixed local value
# (a random token would be an invalid ID). Another one:
#   docker run --rm apache/kafka:3.7.1 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
CDC_TOPIC=customer_cdc
CLICKSTREAM_TOPIC=clickstream_events
TOPIC_PARTITIONS=3
TOPIC_RETENTION_MS=604800000

# -----------------------------------------------------------------------------
# SPARK
# -----------------------------------------------------------------------------
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
SPARK_DRIVER_MEMORY=1g
SPARK_EXECUTOR_MEMORY=1g

# -----------------------------------------------------------------------------
# PRIVACY
# -----------------------------------------------------------------------------
# HMAC key for email tokens in Silver (>= 32 random bytes, base64). Rotating it
# changes all tokens; keep it stable per environment.
PII_HMAC_KEY=change-me

# -----------------------------------------------------------------------------
# AIRFLOW (orchestration profile, Milestone 2)
# -----------------------------------------------------------------------------
# Fernet key: 44 characters (url-safe base64 of 32 bytes). bootstrap_env.py generates a valid one.
AIRFLOW__CORE__FERNET_KEY=change-me
AIRFLOW__API__SECRET_KEY=change-me
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
# Optional alert webhook (e.g. Slack incoming webhook). Leave empty to log payloads only.
ALERT_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# AWS (Milestone 3) — names only, no credentials
# -----------------------------------------------------------------------------
AWS_PROFILE=lakehouse-dev
AWS_REGION=eu-central-1

# -----------------------------------------------------------------------------
# GENERATOR (pydantic-settings, GEN_ prefix)
# -----------------------------------------------------------------------------
GEN_SEED=42
GEN_TENANTS=["brand_alpha","brand_beta","brand_gamma"]
GEN_TENANT_WEIGHTS=[0.6,0.3,0.1]
GEN_KAFKA_BOOTSTRAP_SERVERS=localhost:9094
GEN_TOPIC_CUSTOMER_CDC=customer_cdc
GEN_TOPIC_CLICKSTREAM=clickstream_events
# Defect rates in percent (0-50)
GEN_SIM_START=2026-01-01T00:00:00Z
GEN_CDC_MAX_UPDATES=4
GEN_CDC_DELETE_RATE=5.0
GEN_CDC_INVALID_EMAIL_RATE=3.0
GEN_CDC_NULL_EMAIL_RATE=2.0
GEN_CDC_FUTURE_SIGNUP_RATE=2.0
GEN_CDC_OUT_OF_ORDER_RATE=5.0
GEN_CDC_DUPLICATE_RATE=2.0
GEN_CDC_CROSS_TENANT_COLLISION_RATE=1.0
GEN_ORDER_ORPHAN_FK_RATE=3.0
GEN_ORDER_LATE_PARENT_RATE=2.0
GEN_ORDER_DUPLICATE_RATE=4.0
GEN_ORDER_FUTURE_TS_RATE=2.0
GEN_ORDER_NEGATIVE_AMOUNT_RATE=1.0
GEN_ORDER_SALES_CHANNEL_FROM_BATCH=10
GEN_PRODUCTS_PER_BRAND=40
GEN_CLICK_LATE_RATE=10.0
GEN_CLICK_DUPLICATE_RATE=4.0
GEN_CLICK_NULL_SESSION_RATE=1.0
GEN_CLICK_MALFORMED_JSON_RATE=0.5

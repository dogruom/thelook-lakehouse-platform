# =============================================================================
# Multi-Tenant CRM Lakehouse — Environment Configuration
# =============================================================================
# USAGE:
#   cp .env.example .env
#   # Edit .env with your actual values (never commit .env to git!)
#
# All defaults are safe for local development.
# For production, rotate ALL credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# PROJECT
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=crm_lakehouse
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# POSTGRESQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=crm_admin
POSTGRES_PASSWORD=crm_secret_2024
POSTGRES_ROOT_DB=postgres

# Airflow metadata database
AIRFLOW_DB_NAME=airflow_metadata
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow_secret_2024

# DWH database
DWH_DB_NAME=crm_dwh
DWH_DB_USER=crm_dwh
DWH_DB_PASSWORD=dwh_secret_2024

# dbt connection (used in dbt profiles.yml)
DBT_HOST=localhost
DBT_PORT=5432
DBT_DATABASE=${DWH_DB_NAME}
DBT_SCHEMA=public
DBT_USER=${DWH_DB_USER}
DBT_PASSWORD=${DWH_DB_PASSWORD}

# -----------------------------------------------------------------------------
# OBJECT STORAGE (SeaweedFS locally, AWS S3 in cloud profile)
# -----------------------------------------------------------------------------
S3_HOST=seaweedfs
S3_PORT=9000
S3_ACCESS_KEY=lakehouse_admin
S3_SECRET_KEY=lakehouse_secret_dev
LAKEHOUSE_BUCKET=lakehouse
S3_ENDPOINT=http://seaweedfs:9000
S3_PATH_STYLE_ACCESS=true

# Lakehouse bucket paths
LAKEHOUSE_BUCKET=lakehouse
BRONZE_PREFIX=bronze
SILVER_PREFIX=silver
GOLD_PREFIX=gold

# -----------------------------------------------------------------------------
# KAFKA (KRaft mode — no ZooKeeper)
# -----------------------------------------------------------------------------
KAFKA_HOST=kafka
KAFKA_PORT=9092
KAFKA_EXTERNAL_PORT=9094
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# Topic configuration
CLICKSTREAM_TOPIC=clickstream_events
CLICKSTREAM_PARTITIONS=3
CLICKSTREAM_REPLICATION_FACTOR=1
CLICKSTREAM_RETENTION_MS=604800000

# Consumer group
SPARK_CONSUMER_GROUP=spark-streaming-group

# -----------------------------------------------------------------------------
# SPARK
# -----------------------------------------------------------------------------
SPARK_MASTER_HOST=spark-master
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8181
SPARK_WORKER_WEBUI_PORT=8182
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
SPARK_DRIVER_MEMORY=1g
SPARK_EXECUTOR_MEMORY=1g

# Spark history server
SPARK_HISTORY_PORT=18080

# Checkpoint location (in object storage)
SPARK_CHECKPOINT_LOCATION=s3a://lakehouse/checkpoints/streaming

# -----------------------------------------------------------------------------
# AIRFLOW
# -----------------------------------------------------------------------------
AIRFLOW_HOST=airflow-webserver
AIRFLOW_WEBSERVER_PORT=8080
AIRFLOW_VERSION=2.9.3
AIRFLOW_IMAGE_NAME=apache/airflow:2.9.3

# Airflow core config
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/dags
AIRFLOW__CORE__FERNET_KEY=ZmDfcTF7_60GrrY167zsiPd67pEvs0aGOv2oasOM1Pg=
AIRFLOW__CORE__SECRET_KEY=crm_airflow_secret_key_change_in_prod

# Airflow connections string
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow_secret_2024@postgres:5432/airflow_metadata

# Airflow webserver
AIRFLOW__WEBSERVER__BASE_URL=http://localhost:8080
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=True

# Airflow default admin credentials
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_ADMIN_EMAIL=admin@crm-lakehouse.local

# -----------------------------------------------------------------------------
# GREAT EXPECTATIONS
# -----------------------------------------------------------------------------
GX_DATA_DOCS_PORT=8888

# -----------------------------------------------------------------------------
# PYTHON / APPLICATION
# -----------------------------------------------------------------------------
PYTHONPATH=/opt/airflow
PYTHONUNBUFFERED=1
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# PORTS SUMMARY (for quick reference)
# -----------------------------------------------------------------------------
# PostgreSQL:     localhost:5432
# SeaweedFS S3:   localhost:9000
# SeaweedFS Filer: localhost:9001
# Kafka:          localhost:9094  (external)
# Spark Master:   localhost:8181
# Spark Worker:   localhost:8182
# Airflow:        localhost:8080
# GX Data Docs:   localhost:8888
